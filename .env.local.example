# Local dev for the fleet domain app. Key names only; every value is blank.
#
# NEXT_PUBLIC_BASE_PATH must be /fleet: toAbsoluteUrl() and apiFetch() read it at runtime.
# NEXTAUTH_SECRET must be byte-identical to the Shell's, or this app cannot decrypt
# the session cookie the Shell issued. Copy it from the Shell - do not invent one.
NEXT_PUBLIC_BASE_PATH=
NEXTAUTH_SECRET=
AUTH_API_BASE_URL=
COMMON_API_BASE_URL=
PERSON_API_BASE_URL=
COMPANY_API_BASE_URL=
